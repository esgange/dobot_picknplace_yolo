string configuration_id
float64 x_mm
float64 y_mm
# Saved Tray Detect Pose tool orientation followed by this local tool-Z rotation.
float64 rotation_deg
bool save_debug_images
---
# SUCCESS acknowledges all placement commands accepted through final retract.
# ControllerStatus remains PLACING/operation_active until supervised completion;
# later failures are reported through status. No final Home motion is queued.
uint8 SUCCESS=0
uint8 CANCELED=2
uint8 COMMAND_REJECTED=3
uint8 FEEDBACK_FAILURE=4
uint8 STOP_UNCONFIRMED=5
uint8 CONTROLLER_FAULT=6
uint8 outcome
string message
string final_state
---
string phase
string waypoint
string message
