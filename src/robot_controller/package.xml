<?xml version="1.0"?>
<package format="3">
  <name>robot_controller</name>
  <version>0.0.1</version>
  <description>Non-actuating first-stage robot controller and strict item-profile validation.</description>
  <maintainer email="maintainer@example.com">maintainer</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>item_perception_yolo</depend>
  <depend>rclpy</depend>
  <depend>item_perception_interfaces</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
