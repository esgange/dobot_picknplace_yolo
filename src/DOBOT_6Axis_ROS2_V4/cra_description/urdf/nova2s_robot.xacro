<?xml version="1.0"?>
<robot name="nova2s_robot" xmlns:xacro="http://ros.org/wiki/xacro">
  <link name="dummy_link" />
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="1.0209E-06 0.00010913 0.063235"
        rpy="0 0 0" />
      <mass
        value="0.91548" />
      <inertia
        ixx="0.0018379"
        ixy="-7.0677E-07"
        ixz="1.1593E-07"
        iyy="0.0018392"
        iyz="-6.2348E-06"
        izz="0.0012494" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find cra_description)/meshes/nova2s/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 50" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find cra_description)/meshes/nova2s/base_link.STL" />
      </geometry>
    </collision>
  </link>
    <link  name="world"/>
  <joint name="world_joint" type="fixed">
    <origin xyz="0 0 0.03" rpy="0 0 0" />
    <parent link="world" />
    <child  link="dummy_link" />
  </joint>
  <joint name="dummy_joint" type="fixed">
      <parent link="dummy_link" />
      <child  link="base_link" />
    </joint>
  <link
    name="Link1">
