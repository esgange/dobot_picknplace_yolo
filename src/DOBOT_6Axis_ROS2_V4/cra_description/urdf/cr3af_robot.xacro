<?xml version="1.0"?>
<robot name="cr3af_robot" xmlns:xacro="http://ros.org/wiki/xacro">
  <link name="dummy_link" />
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-0.0015345 -1.0554E-05 0.028348"
        rpy="0 0 0" />
      <mass
        value="0.74" />
      <inertia
        ixx="0.00074849"
        ixy="5.9724E-08"
        ixz="-1.3251E-06"
        iyy="0.00079951"
        iyz="1.6433E-07"
        izz="0.0010879" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find cra_description)/meshes/cr3af/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.59216 0.59216 0.59216 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find cra_description)/meshes/cr3af/base_link.STL" />
      </geometry>
    </collision>
  </link>
    <link  name="world"/>
  <joint name="world_joint" type="fixed">
    <origin xyz="0 0 0.03" rpy="0 0 0" />
    <parent link="world" />
    <child  link="dummy_link" />
  </joint>
  <joint name="dummy_joint" type="fixed">
      <parent link="dummy_link" />
      <child  link="base_link" />
    </joint>
  <link
    name="Link1">
    <inertial>
      <origin
        xyz="0.0039443 -3.6376E-05 0.073442"
        rpy="0 0 0" />
      <mass
        value="4.45" />
      <inertia
        ixx="0.0030782"
