Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Value: true
    - Class: rviz_default_plugins/TF
      Frame Timeout: 2.5
      Name: TF
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Item Teach - 10 mm colored voxels
      Enabled: true
      Value: true
      Topic:
        Value: /item_teach/voxel_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Position Transformer: XYZ
      Color Transformer: RGB8
      Style: Boxes
      Size (m): 0.010
      Alpha: 1
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Item Teach - valid item poses
      Enabled: true
      Value: true
      Topic:
        Value: /item_teach/valid_items
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.3
      Name: Current View
      Pitch: 0.33
      Value: Orbit (rviz)
      Yaw: 5.5
Window Geometry:
  Height: 800
  Width: 1200
