# Project-wide runtime configuration.
# Copy this file to .env and edit values for the machine/robot in use:
#   cp .env.example .env
#
# .env is intentionally ignored by Git. The canonical shell loader and bringup
# launch require it and do not use alternate configuration files or values.
# Use strict KEY=value syntax; do not add export prefixes or alternate keys.

# Restrict ROS 2 discovery and DDS communication to this computer.
ROS_LOCALHOST_ONLY=1

# Dobot CR10 controller LAN1 address (primary).
DOBOT_ROBOT_LAN1_IP=192.168.20.204

# Dobot CR10 controller LAN2 diagnostic address (secondary).
DOBOT_ROBOT_LAN2_IP=192.168.200.1

# Maximum wait for each Dobot TCP channel connection.
DOBOT_CONNECTION_TIMEOUT_MS=3000

# This workspace contains one Dobot CR10 profile only.
DOBOT_ROBOT_TYPE=cr10

# Single-robot bringup settings.
DOBOT_ROBOT_NUMBER=1
DOBOT_TRAJECTORY_DURATION=0.3
DOBOT_ROBOT_NODE_NAME=dobot_bringup_ros2


# Orbbec Gemini 335 camera mapping. Serial numbers are intentionally empty
# until selected and saved by the non-headless orbbec_camera_launcher GUI.
ORBBEC_CAMERA_1_NAME=bin_camera
ORBBEC_CAMERA_1_SERIAL=
ORBBEC_CAMERA_2_NAME=robot_camera
ORBBEC_CAMERA_2_SERIAL=

# Absolute Gemini 335 stream profile.
ORBBEC_DEVICE_PRESET=High Accuracy
ORBBEC_ENABLE_COLOR=true
ORBBEC_ENABLE_DEPTH=true
ORBBEC_DEPTH_REGISTRATION=true
ORBBEC_ALIGN_TARGET_STREAM=COLOR
ORBBEC_ALIGN_MODE=SW
ORBBEC_ENABLE_FRAME_SYNC=true
ORBBEC_ENABLE_TEMPORAL_FILTER=true
ORBBEC_COLOR_WIDTH=848
ORBBEC_COLOR_HEIGHT=480
ORBBEC_COLOR_FPS=30
ORBBEC_DEPTH_WIDTH=848
ORBBEC_DEPTH_HEIGHT=480
ORBBEC_DEPTH_FPS=30
ORBBEC_ENABLE_POINT_CLOUD=false

# USB-only camera discovery. ROS remains localhost-only.
ORBBEC_ENUMERATE_NET_DEVICE=false

# Strict connection, health, retry, and shutdown timing.
ORBBEC_SCAN_TIMEOUT_SEC=8
ORBBEC_STARTUP_TIMEOUT_SEC=5
ORBBEC_HEALTH_TIMEOUT_SEC=5
ORBBEC_CHECK_PERIOD_SEC=1
ORBBEC_MAX_ATTEMPTS=3
ORBBEC_RETRY_DELAY_SEC=3
ORBBEC_SHUTDOWN_TIMEOUT_SEC=3
